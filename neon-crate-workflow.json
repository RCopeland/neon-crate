      "parameters": {
        "sendTo": "robcopeland@fastmail.com",
        "subject": "=Neon Crate - {{ $today.toLocaleString() }}",
        "message": "=<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#f4f4f4\">\n  <tr>\n    <td align=\"center\" style=\"padding: 24px;\">\n\n```\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#ffffff\" style=\"border-collapse: collapse;\">\n\n    <!-- Header -->\n    <tr>\n      <td style=\"padding: 32px 32px 16px 32px;\">\n        <h1 style=\"margin:0;font-family:Arial,sans-serif;font-size:28px;line-height:34px;color:#111111;\">\n          \ud83c\udfa7 Your Weekly Music Discoveries\n        </h1>\n        <p style=\"margin:8px 0 0 0;font-family:Arial,sans-serif;font-size:14px;color:#666666;\">\n          {{ $today.toLocaleString() }}\n        </p>\n      </td>\n    </tr>\n\n    <!-- Intro -->\n    <tr>\n      <td style=\"padding:0 32px 24px 32px;\">\n        <p style=\"font-family:Arial,sans-serif;font-size:16px;line-height:24px;color:#333333;margin:0;\">\n          Hi Rob,\n        </p>\n\n        <p style=\"font-family:Arial,sans-serif;font-size:16px;line-height:24px;color:#333333;margin:16px 0 0 0;\">\n          I analyzed this week's music news, reviews, and release coverage and found several discoveries that strongly match your taste profile.\n        </p>\n      </td>\n    </tr>\n\n<tr> <td bgcolor=\"#1DB954\" style=\"border-radius:4px;\"> <a href=\"{{ $('Create a playlist').item.json.external_urls.spotify }}\" target=\"_blank\" style=\" display:inline-block; padding:14px 24px; font-family:Arial,sans-serif; font-size:16px; font-weight:bold; color:#ffffff; text-decoration:none; \" > \u25b6 Open This Week's Playlist </a> </td> </tr>\n\n    {{ $('Basic LLM Chain').item.json.output.recommendations.map(item => `\n<tr>\n      <td style=\"padding:24px 32px;border-top:1px solid #eeeeee;\">\n        <p style=\"margin:0;font-family:Arial,sans-serif;font-size:12px;color:#777777;text-transform:uppercase;\">\n          Track\n        </p>\n\n        <h2 style=\"margin:8px 0 4px 0;font-family:Arial,sans-serif;font-size:22px;color:#111111;\">\n          ${item.name}\n        </h2>\n\n        <p style=\"margin:0;font-family:Arial,sans-serif;font-size:16px;color:#555555;\">\n          ${item.artist}\n        </p>\n\n        <p style=\"margin:16px 0 0 0;font-family:Arial,sans-serif;font-size:15px;line-height:22px;color:#333333;\">\n          ${item.createDate} - ${item.reason}\n        </p>\n      </td>\n    </tr>\n\n`) }}\n    \n    <!-- Summary -->\n    <tr>\n      <td style=\"padding:32px;border-top:1px solid #eeeeee;background-color:#fafafa;\">\n\n        <h3 style=\"margin:0 0 16px 0;font-family:Arial,sans-serif;font-size:18px;color:#111111;\">\n          Discovery Summary\n        </h3>\n\n        <p style=\"margin:0;font-family:Arial,sans-serif;font-size:15px;line-height:24px;color:#333333;\">\n          \u2022 70% new releases<br>\n          \u2022 30% catalog discoveries<br>\n          \u2022 Strongest themes: atmospheric indie, groove-oriented soul, jazz rap, and ambient electronic\n        </p>\n\n      </td>\n    </tr>\n\n    <!-- Footer -->\n    <tr>\n      <td style=\"padding:24px 32px;\">\n        <p style=\"margin:0;font-family:Arial,sans-serif;font-size:14px;color:#777777;\">\n          NeonCrate<br>\n          Your Personal Music Discovery Engine\n        </p>\n      </td>\n    </tr>\n\n  </table>\n\n</td>\n```\n\n  </tr>\n</table>\n",
        "options": {}
